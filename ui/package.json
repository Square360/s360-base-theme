{
  "name": "@s360-base-theme/ui",
  "client": "S360 Base Theme",
  "packageManager": "yarn@4.4.1",
  "version": "1.0.0",
  "description": "Storybook development for Drupal themes.",
  "keywords": [
    "component library",
    "design system",
    "drupal",
    "pattern library",
    "storybook",
    "styleguide"
  ],
  "author": "Square360, Inc. <info@square360.com>",
  "contributors": [
    {
      "name": "Steven Keiser",
      "email": "steven.keiser@square360.com"
    }
  ],
  "license": "ISC",
  "scripts": {
    "build": "yarn vite:prod && \"yarn storybook-build\"",
    "develop": "concurrently --raw \"yarn vite:dev\" \"yarn storybook\"",
    "storybook": "storybook dev --ci -p 6006",
    "storybook-build": "storybook build -o ../.storybook-out",
    "webpack": "yarn vite:dev",
    "vite": "yarn vite:dev",
    "vite:dev": "node ./scripts/vite-build.mjs --watch --mode development",
    "vite:prod": "node ./scripts/vite-build.mjs --mode production",
    "generate": "plop"
  },
  "dependencies": {
    "@s360-base-theme/ui-core": "workspace:^1.0.0",
    "add-attributes-twig-extension": "0.1.0",
    "s360-scss-toolkit": "git+https://bitbucket.org/sq360_sysadmin/s360-scss-toolkit.git#1.2.2",
    "twig-drupal-filters": "3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-links": "9.1.20",
    "@storybook/html-vite": "9.1.20",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.4",
    "drupal-attribute": "1.2.1",
    "drupal-twig-extensions": "1.0.0-beta.5",
    "fast-glob": "^3.3.3",
    "glob": "13.0.6",
    "js-yaml": "^5.2.3",
    "plop": "4.0.5",
    "postcss": "8.5.26",
    "postcss-scss": "4.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.102.0",
    "storybook": "9.1.20",
    "storybook-addon-data-theme-switcher": "2.0.2",
    "storybook-addon-render-modes": "^0.0.11",
    "terser": "^5.50.0",
    "twig": "3.0.0",
    "vite": "^8.2.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-svg-icons": "^2.0.1"
  }
}
