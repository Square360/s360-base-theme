import {{ storybookComponentName }}Twig from './{{ componentFilename }}.twig';
import {{ storybookComponentName }}Data from './{{ componentFilename }}.yml';
import './{{ componentFilename }}.js';

{{~#if includeIsPublished~}}import { setPublishedStatus } from '.storybook/utils';{{/if}}

/**
 * Storybook Definition.
 */
export default {
  title: '{{ storybookTitle }}',{{#if includeIsPublished}}
  args: {
    {{ entityType }}_is_published: true,
  },
  argTypes = {
  {{ entityType }}_is_published: { name: 'Published' }
  }{{/if}}
};

export const {{ storybookFunctionName }} = (args) => {
  // Create deep copy of data and merge args.
  let data = Object.assign(structuredClone({{ storybookComponentName }}Data ?? {}), args);
  {{#if includeIsPublished~}}data.{{ entityType }} = setPublishedStatus(data.{{ entityType }}_is_published ?? true);{{~/if}}

  return {{ storybookComponentName }}Twig({
    ...data,
  });
}
{{ storybookFunctionName }}.args = {{ storybookComponentName }}Data;
